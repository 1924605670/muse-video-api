# 全部为占位值，切勿填入真实密钥后提交到公开仓库。
# 复制为 .env 后填入真实值使用。

# sandbox | production（默认 sandbox：接受字面凭证 SANDBOX-PROOF-OK）
AIPAY_MODE=sandbox

# 支付宝开放平台应用 AppId（生产必填，沙箱可留空）
AIPAY_APP_ID=

# 商户私钥（PKCS#1 Base64 或 PEM；仅用于本地账单签名，生产必填）
AIPAY_PRIVATE_KEY=

# 支付宝公钥（生产必填）
AIPAY_PUBLIC_KEY=

# 商户号（2088 开头；沙箱可用默认值）
AIPAY_SELLER_ID=2088SANDBOX

# 服务市场 serviceId；沙箱固定 api_mock_service_id，生产替换为真实值
AIPAY_SERVICE_ID=api_mock_service_id

# 支付宝网关；生产：https://openapi.alipay.com/gateway.do
AIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 单次视频价格（元），当前 ¥0.1/次
PRICE_CNY=0.1

# 服务端口（Zeabur 会注入 PORT）
PORT=3000

# worker 回调口令：worker 调用 /processing 与 /complete 时必须带
# X-Worker-Token: <WORKER_TOKEN>。生产必须设置一个强随机值，
# 且不要与任何其他服务的口令相同。
WORKER_TOKEN=change-me-to-a-long-random-string

# 任务存储文件（默认 data/jobs.json；测试可用临时路径覆盖）
# JOBS_FILE=
